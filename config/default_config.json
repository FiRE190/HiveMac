{
  "app": {
    "debug_mode": false,
    "emergency_stop_key": "f9",
    "window_width": 480,
    "window_height": 760,
    "theme": "dark"
  },
  "detection": {
    "backpack_pct_confidence": 0.75,
    "template_match_threshold": 0.80,
    "death_screen_threshold": 0.85,
    "hive_threshold": 0.80,
    "mob_threshold": 0.78
  },
  "timing": {
    "ui_poll_ms": 200,
    "watchdog_interval_sec": 30,
    "watchdog_timeout_sec": 60,
    "movement_loop_delay_ms": 80,
    "click_hold_ms": 120
  },
  "movement": {
    "default_pattern": "circular",
    "base_speed": 1.0,
    "randomness": 0.3,
    "micro_pause_chance": 0.08,
    "micro_pause_min_ms": 50,
    "micro_pause_max_ms": 250
  },
  "screen": {
    "scale_factor": 2.0,
    "roblox_window_title": "Roblox",
    "regions": {
      "backpack_pct": {"left": 0, "top": 0, "width": 0, "height": 0},
      "field_name": {"left": 0, "top": 0, "width": 0, "height": 0},
      "pollen_count": {"left": 0, "top": 0, "width": 0, "height": 0}
    }
  },
  "power": {
    "reduce_brightness_on_start": false,
    "brightness_level": 50,
    "caffeinate": true
  },
  "wealth_clock": {
    "enabled": true,
    "interval_min": 61,
    "reset_character": false
  },
  "mob_run": {
    "enabled": true,
    "interval_min": 64,
    "max_retries": 3
  },
  "death_recovery": {
    "backup_field_farming_min": 30
  }
}
