# BeeSwarm Local Macro — environment variables
# Copy to .env and fill in if needed.
# The macro works fully offline; none of these are required.

# Optional: future Clerk cloud sync
# CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...

# Optional: override Tesseract path if not on system PATH
# TESSERACT_CMD=/opt/homebrew/bin/tesseract
